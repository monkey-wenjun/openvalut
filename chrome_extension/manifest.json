{
  "manifest_version": 3,
  "name": "OpenValut Autofill",
  "version": "0.1.0",
  "description": "Auto-fill passwords and TOTP codes from your OpenValut KDBX vault.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging",
    "idle",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rpc-contract.js", "passkey-inject.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["rpc-contract.js", "dom-scanner.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "192": "icons/icon-192.png"
    }
  },
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["inject-passkey.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
